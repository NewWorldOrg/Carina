# Copy to .env and set what this host needs. .env is not committed.

# The address browsers reach this deployment on. Left unset, redirect URIs are
# guessed from the address a request arrived on.
CARINA_PUBLIC_ORIGIN=

# The video encoder: Software or Vaapi. Vaapi needs /dev/dri in the container,
# which `task up` passes in when the host has it, and falls back to software on
# a host where the render node is missing or cannot be opened.
CARINA_TRANSCODING_PREFER=Software

# The database password the app and PostgreSQL agree on.
POSTGRES_PASSWORD=carina

# The port the API is published on.
API_PORT=8081

# Where recordings are written on this host. Left unset, a Docker volume holds
# them. A hard link cannot cross filesystems, so a migration that carries
# recordings over needs this on the same filesystem as the directory it reads.
CARINA_RECORDINGS_DIR=
